---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
    const work = await getCollection("work");
    return work.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, period, company, role, highlights, stack, featured } =
    entry.data;
---

<Base title={title} description={summary}>
    <div class="case-header">
        {
            featured ? (
                <a class="back" href="/#work">
                    ← 대표 사례
                </a>
            ) : (
                <a class="back" href="/#projects">
                    ← 그 밖의 프로젝트
                </a>
            )
        }
        <h1>{title}</h1>
        <p class="muted">{company} · {period} · {role}</p>
        <p class="summary">{summary}</p>
        <div class="case-highlights">
            <ul>{highlights.map((h) => <li>{h}</li>)}</ul>
        </div>
    </div>
    <article class="prose">
        <Content />
        <h2>기술</h2>
        <ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul>
    </article>
</Base>
